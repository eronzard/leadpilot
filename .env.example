# --- LLM -------------------------------------------------------------
# "claude" uses the Anthropic API (needs ANTHROPIC_API_KEY).
# "rules" is a deterministic keyword engine: no API key, used in CI and as the
# automatic fallback when Claude errors out or declines.
LEADPILOT_QUALIFIER=claude
ANTHROPIC_API_KEY=
LEADPILOT_MODEL=claude-opus-5-5
LEADPILOT_EFFORT=low

# --- Storage ---------------------------------------------------------
LEADPILOT_DB_PATH=data/leadpilot.db
LEADPILOT_BUSINESS_CONFIG=config/business.yaml

# --- Webhook security ------------------------------------------------
# If set, POST /webhooks/lead must carry X-LeadPilot-Signature: sha256=<hex HMAC of raw body>
LEADPILOT_WEBHOOK_SECRET=
# Per-IP limit for UNSIGNED webhook calls (0 disables). Signed calls are not limited.
LEADPILOT_RATE_LIMIT_PER_MINUTE=30
# Protects the dashboard's write actions (approve / retry). Sent as X-Admin-Token.
LEADPILOT_ADMIN_TOKEN=

# Public base URL of this deployment; Slack alerts link to <url>/#lead=<id>.
LEADPILOT_PUBLIC_URL=

# --- CRM -------------------------------------------------------------
# "local" keeps contacts/deals in SQLite. "hubspot" uses a HubSpot private-app token.
LEADPILOT_CRM=local
HUBSPOT_TOKEN=
HUBSPOT_PIPELINE_ID=default
HUBSPOT_DEALSTAGE_ID=appointmentscheduled

# --- Notifications ---------------------------------------------------
# Slack incoming webhook URL; leave empty to log notifications only.
SLACK_WEBHOOK_URL=

# --- Email -----------------------------------------------------------
# "outbox" stores sent mail in SQLite (safe default). "smtp" really sends.
LEADPILOT_MAILER=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Worker ----------------------------------------------------------
LEADPILOT_MAX_ATTEMPTS=4
LEADPILOT_RETRY_BASE_SECONDS=5
# Fetch the lead's company website <title>/<meta description> during enrichment.
LEADPILOT_ENRICH_FETCH_WEBSITE=false
# Chaos testing: probability (0-1) that a CRM write raises a transient error.
LEADPILOT_FAULT_CRM_RATE=0
